      transition: transform 0.35s, box-shadow 0.35s; position: relative; overflow: hidden;
    }
    #btn-surprise:hover { transform: translateY(-2px); box-shadow: 0 10px 36px var(--gold-glow); }
    #btn-surprise:focus-visible { outline: 2px solid var(--soft-cream); outline-offset: 3px; }
    #hidden-block { display: none; animation: reveal-block 0.7s var(--ease-out-expo) both; }
    #hidden-block.show { display: block; }
    @keyframes reveal-block {
      from { opacity:0; transform:translateY(12px) }
      to { opacity:1; transform:translateY(0) }
    }
    #hidden-text {
      font-size: clamp(0.88rem,3vw,0.98rem); line-height: 1.95;
