    }
    .card-divider {
      width: 56px; height: 1px; margin: 0 auto 1.35rem;
      background: linear-gradient(90deg, transparent, var(--warm-gold), transparent);
    }
    #btn-surprise {
      display: block; width: 100%; padding: 1rem 1.25rem;
      font-size: 1rem; font-weight: 600; color: var(--deep-navy);
      background: linear-gradient(135deg, #ffe9a8, var(--warm-gold));
