    }
    .name-gold { color: var(--warm-gold); font-weight: 500; -webkit-text-fill-color: var(--warm-gold); }
    .type-cursor {
      display: inline-block; width: 2px; height: 1em; background: var(--warm-gold);
      vertical-align: text-bottom; animation: blink 0.8s step-end infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }
    #star-progress {
      margin-top: 1.25rem; text-align: center; font-size: 0.85rem;
      color: var(--moonlight-blue); display: none;
    }
    #star-progress.show { display: block; }

    /* Final overlay */
    #final-overlay {
      position: fixed; inset: 0; z-index: 80;
      display: none; align-items: center; justify-content: center;
      padding: 1.5rem; background: rgba(7,11,31,.55);
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    }
    #final-overlay.show { display: flex; animation: overlay-in 0.9s var(--ease-out-expo) both; }
    @keyframes overlay-in { from{opacity:0} to{opacity:1} }
    .final-aura {
      position: absolute; width: min(90vw,480px); height: min(70vh,400px);
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(246,201,107,.25) 0%, transparent 70%);
      animation: aura-pulse 4s ease-in-out infinite; pointer-events: none;
    }
    @keyframes aura-pulse { 0%,100%{transform:scale(1);opacity:.6} 50%{transform:scale(1.08);opacity:1} }
    .final-card {
      position: relative; width: min(100%,460px);
      padding: clamp(2rem,6vw,2.75rem);
      background: rgba(255,255,255,.1); backdrop-filter: blur(24px);
      border: 1px solid rgba(246,201,107,.4); border-radius: 28px;
      box-shadow: 0 0 80px rgba(246,201,107,.35), 0 30px 100px rgba(0,0,0,.5);
      text-align: center;
      animation: final-rise 1s var(--ease-out-expo) 0.15s both;
    }
    @keyframes final-rise {
      from { opacity:0; transform:translateY(30px) scale(.95) }
      to { opacity:1; transform:translateY(0) scale(1) }
    }
    .final-ring {
      position: absolute; inset: -2px; border-radius: 30px; z-index: -1; opacity: 0.6;
      background: linear-gradient(135deg, rgba(246,201,107,.5), transparent 40%, rgba(175,203,255,.3), transparent 70%, rgba(247,168,184,.3));
      animation: ring-rotate 12s linear infinite;
    }
    @keyframes ring-rotate { to { transform: rotate(360deg); } }
    .final-symbol { font-size: 1.25rem; color: var(--warm-gold); margin-bottom: 1rem; }
    .final-text {
      font-size: clamp(1rem,3.8vw,1.12rem); line-height: 2;
      color: var(--soft-cream); margin-bottom: 1.75rem;
    }
    .final-footer { font-size: 0.8rem; color: rgba(255,243,208,.45); letter-spacing: 0.04em; }
    #page-footer {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 16;
      text-align: center; padding: 0 1rem 1.25rem;
      font-size: 0.72rem; color: rgba(255,243,208,.3); pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Playful intro -->
  <section id="playful" aria-label="پێشەکی یاری">
    <div class="playful-bg" aria-hidden="true"></div>
    <div class="playful-moon-glow" aria-hidden="true"></div>
    <div id="playful-particles" aria-hidden="true"></div>
    <div class="playful-content">
      <p class="playful-question"><span class="name-ltr">Runahi</span>، تۆ ڕقت لێمە؟</p>
      <button type="button" id="btn-no" aria-label="نەخێر">نەخێر 💖</button>
    </div>
    <button type="button" id="btn-yes-escape" aria-label="بەڵێ — دوگمەی هەڵدەر">بەڵێ 😐</button>
    <div id="float-msgs"></div>
    <p id="playful-hint" class="playful-hint hidden">ڕاستە قسەکە… نەخێر 💖</p>
  </section>

  <!-- Cinematic intro -->
  <section id="intro" class="hidden" aria-label="دەستپێکردن">
    <div class="intro-glow" aria-hidden="true"></div>
    <div class="intro-content">
      <h1 class="intro-title">سوپرایزێکی بچووک بۆ Runahi</h1>
      <p class="intro-sub">شەوێکی ئارام، مانگێکی ڕوون، و پەیامێکی تایبەت بۆ جەژنی قوربان</p>
      <button type="button" id="btn-start" aria-label="دەست پێ بکە">دەست پێ بکە</button>
    </div>
  </section>

  <!-- Scene -->
  <div id="scene" aria-hidden="true">
    <div class="scene-gradient"></div>
    <div class="scene-nebula"></div>
    <div class="scene-beam"></div>
    <div class="cloud cloud1"></div>
    <div class="cloud cloud2"></div>
    <div class="cloud cloud3"></div>
  </div>

  <div id="stars-layer" class="hidden" aria-hidden="true"></div>
  <div id="particles-layer" class="hidden" aria-hidden="true"></div>
  <div id="petals-layer" class="hidden" aria-hidden="true"></div>
  <div id="hearts-layer" class="hidden" aria-hidden="true"></div>
  <div id="golden-rain" class="hidden" aria-hidden="true"></div>

  <div id="lanterns" class="hidden" aria-hidden="true">
    <div class="lantern lantern-left" id="lantern-l">
      <div class="l-hook"></div><div class="l-cap"></div><div class="l-body"></div><div class="l-light"></div>
    </div>
    <div class="lantern lantern-right" id="lantern-r">
      <div class="l-hook"></div><div class="l-cap"></div><div class="l-body"></div><div class="l-light"></div>
    </div>
  </div>

  <button type="button" id="moon-btn" class="hidden" aria-label="گۆڕینی دۆخی جەژن" aria-pressed="false">
    <div class="moon-wrap">
      <div class="moon-halo"></div>
      <div class="moon-disc"></div>
      <div class="moon-shadow"></div>
      <span class="moon-hint"></span>
    </div>
  </button>

  <div id="collect-stars" class="hidden">
    <p class="star-hint hidden" id="star-hint">٥ ئەستێرە بدۆزەرەوە</p>
  </div>

  <main id="main-wrap" class="hidden">
    <article id="main-card" aria-label="پەیامی جەژن">
      <span class="ornament orn-tl" aria-hidden="true"></span>
      <span class="ornament orn-br" aria-hidden="true"></span>
      <h1 class="card-title"><span class="name-ltr">Runahi</span>، جەژنی قوربانت پیرۆز بێت</h1>
      <p class="card-sub">هیوادارم ئەم جەژنە بۆت پڕ بێت لە خۆشی، ئاشتی و ڕووناکی</p>
      <div class="card-divider" aria-hidden="true"></div>
      <button type="button" id="btn-surprise" aria-label="سوپرایزەکە بکەرەوە">سوپرایزەکە بکەرەوە</button>
      <div id="hidden-block" role="region" aria-label="پەیامی نهێنی">
        <p id="hidden-text"></p>
      </div>
      <p id="star-progress" aria-live="polite"></p>
    </article>
  </main>

  <div id="final-overlay" role="dialog" aria-modal="true" aria-label="پەیامی کۆتایی">
    <div class="final-aura" aria-hidden="true"></div>
    <article class="final-card">
      <div class="final-ring" aria-hidden="true"></div>
      <p class="final-symbol" aria-hidden="true">✦</p>
      <p class="final-text">با ئەم جەژنە بۆت هێندە جوان بێت وەک ڕووناکی مانگ، هێندە ئارام بێت وەک شەوی پڕ ئەستێرە، و هێندە تایبەت بێت وەک ئەو ساتانەی بەبێ قسە دەمێننەوە.</p>
      <footer class="final-footer">بە ڕێز و هیوای جوان</footer>
    </article>
  </div>

  <div id="sparkle-burst" aria-hidden="true"></div>
  <footer id="page-footer" class="hidden">بە ڕێز و هیوای جوان</footer>

  <script>
(function () {
  "use strict";

  var HIDDEN_MSG = "Runahi، جەژنی قوربانت پیرۆز بێت. هیوادارم ئەم ڕۆژە جوانە بۆت پڕ بێت لە خۆشی، ئاشتی، ڕووناکی و هەموو شتێکی جوان. ئەم سوپرایزە بچووکە تەنها بۆ ئەوەی جەژنت کەمێک تایبەت‌تر بکات.";
  var ESCAPE_REACTIONS = ["هەوڵ مەدە 😭", "ئەم دوگمەیە هەڵدەکات", "دڵی شکاوە 😔", "باشە باشە، نەخێر 💖", "بەڵێ قبوڵ ناکات 😭"];
  var STAR_POSITIONS = [
    { top: "18%", left: "12%" }, { top: "22%", left: "82%" },
    { top: "62%", left: "8%" }, { top: "58%", left: "88%" }, { top: "78%", left: "50%" }
  ];
  var KURDISH_DIGITS = ["٠","١","٢","٣","٤","٥","٦","٧","٨","٩"];
  var TOTAL_STARS = 5;
  var MANY_ATTEMPTS = 5;
  var PROXIMITY = 110;
  var PAD = 14;
  var MIN_JUMP = 72;

  var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var state = {
    phase: "playful",
    celebrationMode: false,
    surpriseOpen: false,
    collectedStars: {},
    finalUnlocked: false,
    failedAttempts: 0,
    escapePos: { x: 0, y: 0 },
    escapeReady: false,
    isEscaping: false,
    escapeCooldown: false,
    typingTimer: null
  };

  var escapeAnimId = null;
  var escapePosRef = { x: 0, y: 0 };

  /* DOM */
  var elPlayful = document.getElementById("playful");
  var elIntro = document.getElementById("intro");
  var elScene = document.getElementById("scene");
  var elMainWrap = document.getElementById("main-wrap");
  var elMainCard = document.getElementById("main-card");
  var elBtnNo = document.getElementById("btn-no");
  var elBtnEscape = document.getElementById("btn-yes-escape");
  var elBtnStart = document.getElementById("btn-start");
  var elBtnSurprise = document.getElementById("btn-surprise");
  var elHiddenBlock = document.getElementById("hidden-block");
  var elHiddenText = document.getElementById("hidden-text");
  var elStarProgress = document.getElementById("star-progress");
  var elCollectStars = document.getElementById("collect-stars");
  var elStarHint = document.getElementById("star-hint");
  var elMoonBtn = document.getElementById("moon-btn");
  var elFinal = document.getElementById("final-overlay");
  var elPageFooter = document.getElementById("page-footer");
  var elPlayfulHint = document.getElementById("playful-hint");
  var elFloatMsgs = document.getElementById("float-msgs");
  var elSparkleBurst = document.getElementById("sparkle-burst");
  var elLanternL = document.getElementById("lantern-l");
  var elLanternR = document.getElementById("lantern-r");

  function toKurdish(n) {
    return String(n).split("").map(function (d) { return KURDISH_DIGITS[+d] || d; }).join("");
  }

  function burst(x, y, count) {
    count = count || 20;
    elSparkleBurst.innerHTML = "";
    for (var i = 0; i < count; i++) {
      var s = document.createElement("span");
      s.className = "sparkle";
      var angle = (Math.PI * 2 * i) / count;
      var dist = 35 + Math.random() * 55;
      s.style.left = x + "px";
      s.style.top = y + "px";
      s.style.setProperty("--sx", Math.cos(angle) * dist + "px");
      s.style.setProperty("--sy", Math.sin(angle) * dist + "px");
      elSparkleBurst.appendChild(s);
    }
    setTimeout(function () { elSparkleBurst.innerHTML = ""; }, 1200);
  }

  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

  function getEscapeSize() {
    var r = elBtnEscape.getBoundingClientRect();
    return { w: r.width || 120, h: r.height || 48 };
  }

  function randomEscapePoint(avoid) {
    var sz = getEscapeSize();
    var maxX = Math.max(PAD, window.innerWidth - sz.w - PAD);
    var maxY = Math.max(PAD, window.innerHeight - sz.h - PAD);
    for (var i = 0; i < 24; i++) {
      var c = { x: PAD + Math.random() * (maxX - PAD), y: PAD + Math.random() * (maxY - PAD) };
      if (!avoid) return c;
      if (Math.hypot(c.x - avoid.x, c.y - avoid.y) >= MIN_JUMP) return c;
    }
    return { x: PAD + Math.random() * (maxX - PAD), y: PAD + Math.random() * (maxY - PAD) };
  }

  function setEscapePos(p) {
    escapePosRef = p;
    elBtnEscape.style.left = p.x + "px";
    elBtnEscape.style.top = p.y + "px";
    elBtnEscape.style.opacity = "1";
    elBtnEscape.style.transform = "none";
  }

  function placeEscapeInitial() {
    var sz = getEscapeSize();
    var cx = window.innerWidth / 2;
    var cy = window.innerHeight / 2 + 40;
    var initial = {
      x: Math.min(window.innerWidth - sz.w - PAD, cx + 20),
      y: Math.min(window.innerHeight - sz.h - PAD, cy)
    };
    setEscapePos(initial);
    state.escapeReady = true;
  }

  function animateEscapeTo(target, duration, done) {
    if (escapeAnimId) cancelAnimationFrame(escapeAnimId);
    var from = { x: escapePosRef.x, y: escapePosRef.y };
    if (duration <= 0) {
      setEscapePos(target);
      state.isEscaping = false;
      if (done) done();
      return;
    }
    state.isEscaping = true;
    var start = performance.now();
    function tick(now) {
      var t = Math.min(1, (now - start) / duration);
      var e = easeOutCubic(t);
      setEscapePos({
        x: from.x + (target.x - from.x) * e,
        y: from.y + (target.y - from.y) * e
      });
      if (t < 1) escapeAnimId = requestAnimationFrame(tick);
      else {
        state.isEscaping = false;
        escapeAnimId = null;
        if (done) done();
      }
    }
    escapeAnimId = requestAnimationFrame(tick);
  }

  function showFloatMsg(text, x, y) {
    var el = document.createElement("span");
    el.className = "float-msg";
    el.textContent = text;
    el.style.left = x + (Math.random() - 0.5) * 60 + "px";
    el.style.top = y - 20 - Math.random() * 30 + "px";
    elFloatMsgs.appendChild(el);
    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 2200);
  }

  function runEscape(instant) {
    if (state.phase !== "playful" || state.isEscaping || state.escapeCooldown) return;
    state.escapeCooldown = true;
    setTimeout(function () { state.escapeCooldown = false; }, 320);

    var many = state.failedAttempts >= MANY_ATTEMPTS;
    var duration = instant || reducedMotion ? 0 : many ? 220 : 280;

    function doJump() {
      var sz = getEscapeSize();
      var cx = escapePosRef.x + sz.w / 2;
      var cy = escapePosRef.y + sz.h / 2;
      state.failedAttempts++;
      showFloatMsg(ESCAPE_REACTIONS[(state.failedAttempts - 1) % ESCAPE_REACTIONS.length], cx, cy);
      burst(cx, cy, many ? 28 : 14);

      if (many) {
        elBtnNo.classList.add("strong-glow");
        elPlayfulHint.classList.remove("hidden");
        elBtnEscape.classList.add("shake");
        setTimeout(function () {
          elBtnEscape.classList.remove("shake");
          animateEscapeTo(randomEscapePoint(escapePosRef), duration);
        }, 160);
      } else {
        animateEscapeTo(randomEscapePoint(escapePosRef), duration);
      }
    }
    doJump();
  }

  function checkProximity(clientX, clientY) {
    if (state.phase !== "playful" || state.isEscaping) return;
    var r = elBtnEscape.getBoundingClientRect();
    var dist = Math.hypot(clientX - (r.left + r.width / 2), clientY - (r.top + r.height / 2));
    if (dist < PROXIMITY) runEscape(false);
  }

  /* Playful particles */
  var pp = document.getElementById("playful-particles");
  for (var pi = 0; pi < 16; pi++) {
    var dot = document.createElement("span");
    dot.className = "playful-dot";
    dot.style.left = (8 + (pi * 6) % 85) + "%";
    dot.style.animationDelay = pi * 0.35 + "s";
    pp.appendChild(dot);
  }

  elBtnNo.addEventListener("click", function () {
    elPlayful.classList.add("exiting");
    setTimeout(function () {
      elPlayful.classList.add("hidden");
      elIntro.classList.remove("hidden");
      state.phase = "intro";
    }, reducedMotion ? 120 : 850);
  });

  document.addEventListener("mousemove", function (e) {
    if (state.phase === "playful") checkProximity(e.clientX, e.clientY);
  }, { passive: true });

  elBtnEscape.addEventListener("mouseenter", function () {
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) runEscape(false);
  });
  elBtnEscape.addEventListener("click", function (e) { e.preventDefault(); });
  elBtnEscape.addEventListener("touchstart", function (e) {
    e.preventDefault();
    runEscape(true);
  }, { passive: false });

  setTimeout(placeEscapeInitial, 50);
  window.addEventListener("resize", function () {
    if (state.phase !== "playful") return;
    var sz = getEscapeSize();
    var c = {
      x: Math.min(Math.max(PAD, escapePosRef.x), window.innerWidth - sz.w - PAD),
      y: Math.min(Math.max(PAD, escapePosRef.y), window.innerHeight - sz.h - PAD)
    };
    setEscapePos(c);
  });

  /* Cinematic intro */
  elBtnStart.addEventListener("click", function () {
    elIntro.classList.add("exiting");
    setTimeout(function () {
      elIntro.classList.add("hidden");
      enterWorld();
    }, reducedMotion ? 100 : 900);
  });

  function enterWorld() {
    state.phase = "world";
    elScene.classList.add("visible");
    document.getElementById("stars-layer").classList.remove("hidden");
    document.getElementById("particles-layer").classList.remove("hidden");
    document.getElementById("petals-layer").classList.remove("hidden");
    document.getElementById("lanterns").classList.remove("hidden");
    elMainWrap.classList.remove("hidden");
    elPageFooter.classList.remove("hidden");
    buildSkyStars();
    buildParticles();
    buildPetals();
    setTimeout(function () {
      elMainWrap.classList.add("visible");
      elMoonBtn.classList.remove("hidden");
      elMoonBtn.classList.add("visible");
    }, 80);
  }

  function buildSkyStars() {
    var layer = document.getElementById("stars-layer");
    var n = reducedMotion ? 25 : 55;
    for (var i = 0; i < n; i++) {
      var s = document.createElement("span");
      s.className = "sky-star";
      s.style.left = Math.random() * 100 + "%";
      s.style.top = Math.random() * 100 + "%";
      var size = Math.random() > 0.85 ? 3 : 2;
      s.style.width = s.style.height = size + "px";
      s.style.animationDuration = (2.5 + Math.random() * 3) + "s";
      s.style.animationDelay = Math.random() * 4 + "s";
      layer.appendChild(s);
    }
  }

  function buildParticles() {
    var layer = document.getElementById("particles-layer");
    var n = reducedMotion ? 12 : 24;
    for (var i = 0; i < n; i++) {
      var p = document.createElement("span");
      p.className = "particle";
      p.style.left = Math.random() * 100 + "%";
      p.style.width = p.style.height = "4px";
      p.style.setProperty("--drift", (Math.random() - 0.5) * 80 + "px");
      p.style.animationDuration = (10 + Math.random() * 12) + "s";
      p.style.animationDelay = Math.random() * 10 + "s";
      layer.appendChild(p);
    }
  }

  function buildPetals() {
    var layer = document.getElementById("petals-layer");
    for (var i = 0; i < 12; i++) {
      var p = document.createElement("span");
      p.className = "petal";
      p.style.left = Math.random() * 100 + "%";
      p.style.setProperty("--rot", Math.random() * 360 + "deg");
      p.style.animationDuration = (14 + Math.random() * 10) + "s";
      p.style.animationDelay = Math.random() * 12 + "s";
      layer.appendChild(p);
    }
  }

  function setWarmScene() {
    var warm = state.celebrationMode || state.surpriseOpen || state.finalUnlocked;
    elScene.classList.toggle("warm", warm);
    elScene.classList.toggle("final", state.finalUnlocked);
    document.body.classList.toggle("celebration-mode", state.celebrationMode || state.finalUnlocked);
    elMainCard.classList.toggle("celebration", state.celebrationMode);
    elMoonBtn.classList.toggle("celebration", state.celebrationMode);
    elMoonBtn.setAttribute("aria-pressed", state.celebrationMode ? "true" : "false");
    var glow = state.surpriseOpen || state.celebrationMode;
    elLanternL.classList.toggle("glow", glow);
    elLanternR.classList.toggle("glow", glow);
    updateParticleIntensity();
  }

  function updateParticleIntensity() {
    var intense = state.celebrationMode || state.surpriseOpen || state.finalUnlocked;
    document.querySelectorAll("#particles-layer .particle").forEach(function (p) {
      p.style.width = p.style.height = intense ? "5px" : "4px";
    });
  }

  /* Card tilt */
  var MAX_TILT = 8;
  elMainWrap.addEventListener("mousemove", function (e) {
    if (!state.surpriseOpen && state.phase === "world" && !reducedMotion) {
      var r = elMainCard.getBoundingClientRect();
      var cx = r.left + r.width / 2;
      var cy = r.top + r.height / 2;
      var rotY = ((e.clientX - cx) / (r.width / 2)) * MAX_TILT;
      var rotX = -((e.clientY - cy) / (r.height / 2)) * MAX_TILT;
      elMainCard.style.setProperty("--tilt-x", rotX + "deg");
      elMainCard.style.setProperty("--tilt-y", rotY + "deg");
    }
  });
  elMainWrap.addEventListener("mouseleave", function () {
    elMainCard.style.setProperty("--tilt-x", "0deg");
    elMainCard.style.setProperty("--tilt-y", "0deg");
  });

  /* Surprise */
  elBtnSurprise.addEventListener("click", function () {
    state.surpriseOpen = true;
    state.celebrationMode = true;
    elBtnSurprise.classList.add("hidden");
    elMainCard.classList.add("expanded");
    elHiddenBlock.classList.add("show");
    setWarmScene();
    var r = elMainCard.getBoundingClientRect();
    burst(r.left + r.width / 2, r.top + r.height / 2, 24);
    typeHiddenMessage();
    showCollectStars();
    document.getElementById("hearts-layer").classList.remove("hidden");
    buildHearts();
  });

  function typeHiddenMessage() {
    var i = 0;
    elHiddenText.innerHTML = "";
    if (reducedMotion) {
      renderHiddenFull();
      return;
    }
    if (state.typingTimer) clearInterval(state.typingTimer);
    state.typingTimer = setInterval(function () {
      i++;
      renderHiddenPartial(HIDDEN_MSG.slice(0, i));
      if (i >= HIDDEN_MSG.length) {
        clearInterval(state.typingTimer);
        renderHiddenFull();
      }
    }, 28);
  }

  function renderHiddenPartial(text) {
    elHiddenText.innerHTML = formatHidden(text) + '<span class="type-cursor" aria-hidden="true"></span>';
  }

  function renderHiddenFull() {
    elHiddenText.innerHTML = formatHidden(HIDDEN_MSG);
  }

  function formatHidden(text) {
    return text.split(/(Runahi)/g).map(function (part) {
      if (part === "Runahi") return '<span class="name-ltr name-gold">Runahi</span>';
      return part.replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }).join("");
  }

  function showCollectStars() {
    elCollectStars.classList.remove("hidden");
    elStarHint.classList.remove("hidden");
    elStarProgress.classList.add("show");
    updateProgress();
    STAR_POSITIONS.forEach(function (pos, idx) {
      if (state.collectedStars[idx]) return;
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "collect-star";
      btn.style.top = pos.top;
      btn.style.left = pos.left;
      btn.setAttribute("aria-label", "ئەستێرەی " + (idx + 1));
      btn.innerHTML = '<span class="star-shape" aria-hidden="true"></span>';
      btn.dataset.id = idx;
      btn.addEventListener("click", function () {
        var id = +btn.dataset.id;
        if (state.collectedStars[id]) return;
        state.collectedStars[id] = true;
        var rect = btn.getBoundingClientRect();
        burst(rect.left + rect.width / 2, rect.top + rect.height / 2, 20);
        btn.remove();
        updateProgress();
        if (Object.keys(state.collectedStars).length >= TOTAL_STARS) unlockFinal();
      });
      elCollectStars.appendChild(btn);
    });
  }

  function updateProgress() {
    var n = Object.keys(state.collectedStars).length;
    elStarProgress.textContent = "ئەستێرە کۆکراوەکان: " + toKurdish(n) + " / " + toKurdish(TOTAL_STARS);
  }

  function unlockFinal() {
    setTimeout(function () {
      state.finalUnlocked = true;
      state.celebrationMode = true;
      setWarmScene();
      elFinal.classList.add("show");
      elPageFooter.classList.add("hidden");
      document.getElementById("golden-rain").classList.remove("hidden");
      buildGoldenRain();
      buildPetalsExtra();
    }, reducedMotion ? 200 : 600);
  }

  function buildGoldenRain() {
    var layer = document.getElementById("golden-rain");
    layer.innerHTML = "";
    for (var i = 0; i < 28; i++) {
      var f = document.createElement("span");
      f.className = "golden-flake";
      f.style.left = Math.random() * 100 + "%";
      var sz = 3 + Math.random() * 4;
      f.style.width = f.style.height = sz + "px";
      f.style.animationDuration = (3 + Math.random() * 4) + "s";
      f.style.animationDelay = Math.random() * 4 + "s";
      layer.appendChild(f);
    }
  }

  function buildPetalsExtra() {
    var layer = document.getElementById("petals-layer");
    for (var i = 0; i < 6; i++) {
      var p = document.createElement("span");
      p.className = "petal";
      p.style.left = Math.random() * 100 + "%";
      p.style.setProperty("--rot", Math.random() * 360 + "deg");
      p.style.animationDuration = (14 + Math.random() * 10) + "s";
      layer.appendChild(p);
    }
  }

  function buildHearts() {
    var layer = document.getElementById("hearts-layer");
    var spots = [{ top: "35%", left: "18%" }, { top: "55%", left: "78%" }, { top: "72%", left: "42%" }];
    spots.forEach(function (s, i) {
      var h = document.createElement("span");
      h.className = "subtle-heart";
      h.style.top = s.top;
      h.style.left = s.left;
      h.style.animationDelay = i * 2 + "s";
      layer.appendChild(h);
    });
  }

  /* Moon */
  elMoonBtn.addEventListener("click", function () {
    state.celebrationMode = !state.celebrationMode;
    setWarmScene();
    var r = elMoonBtn.getBoundingClientRect();
    burst(r.left + r.width / 2, r.bottom, 18);
  });

})();
  </script>
</body>
</html>
