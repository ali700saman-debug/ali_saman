<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="سوپرایزێکی بچووک بۆ Runahi — جەژنی قوربان">
  <title>جەژنی قوربان — Runahi</title>
  <style>
    :root {
      --deep-navy: #070b1f;
      --midnight-blue: #101735;
      --royal-violet: #2a1e4a;
      --moonlight-blue: #afcbff;
      --warm-gold: #f6c96b;
      --soft-cream: #fff3d0;
      --rose-glow: #f7a8b8;
      --emerald-accent: #7ae7c7;
      --glass: rgba(255, 255, 255, 0.08);
      --glass-border: rgba(255, 255, 255, 0.14);
      --gold-glow: rgba(246, 201, 107, 0.35);
      --moon-glow: rgba(175, 203, 255, 0.25);
      --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      --card-radius: 26px;
      --tilt-x: 0deg;
      --tilt-y: 0deg;
    }
    body.celebration-mode {
      --deep-navy: #120c06;
      --midnight-blue: #221508;
      --royal-violet: #3d2810;
      --moonlight-blue: #ffe4a8;
      --moon-glow: rgba(255, 228, 168, 0.35);
      --gold-glow: rgba(255, 220, 120, 0.45);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-tap-highlight-color: transparent; }
    body {
      font-family: "Segoe UI", Tahoma, system-ui, sans-serif;
      background: var(--deep-navy);
      color: var(--soft-cream);
      min-height: 100vh;
      min-height: 100dvh;
      overflow-x: hidden;
      direction: rtl;
      transition: background 1.2s var(--ease-smooth);
    }
    .name-ltr { direction: ltr; unicode-bidi: embed; display: inline; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; }
    .hidden { display: none !important; }

    /* Sparkles */
    #sparkle-burst {
      position: fixed; inset: 0; z-index: 300; pointer-events: none;
    }
    .sparkle {
      position: absolute; width: 6px; height: 6px; margin: -3px 0 0 -3px;
      border-radius: 50%; background: var(--warm-gold);
      box-shadow: 0 0 12px var(--warm-gold);
      animation: sparkle-pop 1s var(--ease-out-expo) forwards;
    }
    @keyframes sparkle-pop {
      0% { opacity: 1; transform: scale(0); }
      100% { opacity: 0; transform: scale(1.4) translate(var(--sx), var(--sy)); }
    }

    /* ===== PLAYFUL INTRO ===== */
    #playful {
      position: fixed; inset: 0; z-index: 110;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
      transition: opacity 0.85s var(--ease-smooth), transform 0.85s var(--ease-out-expo);
    }
    #playful.exiting { opacity: 0; transform: scale(1.03); pointer-events: none; }
    .playful-bg {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 90% 70% at 50% 25%, var(--royal-violet) 0%, transparent 55%),
        radial-gradient(ellipse 60% 45% at 20% 80%, var(--moon-glow) 0%, transparent 50%),
        linear-gradient(180deg, var(--deep-navy) 0%, var(--midnight-blue) 50%, var(--deep-navy) 100%);
    }
    .playful-moon-glow {
      position: absolute; top: 8%; left: 50%; transform: translateX(-50%);
      width: min(70vw, 320px); height: 35vh;
      background: radial-gradient(ellipse, var(--moon-glow) 0%, transparent 70%);
      filter: blur(35px); animation: glow-pulse 5s ease-in-out infinite; pointer-events: none;
    }
    @keyframes glow-pulse { 0%,100%{opacity:.45} 50%{opacity:.8} }
    .playful-content {
      position: relative; z-index: 2; text-align: center;
      padding: 2rem 1.5rem 6rem; max-width: 400px;
      animation: content-in 1s var(--ease-out-expo) both;
    }
    @keyframes content-in {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .playful-question {
      font-size: clamp(1.4rem, 5.5vw, 1.85rem); font-weight: 600;
      line-height: 1.55; margin-bottom: 2.5rem;
      text-shadow: 0 0 40px var(--moon-glow);
    }
    .playful-question .name-ltr {
      background: linear-gradient(135deg, #ffe9a8, var(--warm-gold));
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    #btn-no {
      min-width: 160px; padding: 1rem 1.75rem; font-size: 1.05rem; font-weight: 600;
      color: var(--deep-navy);
      background: linear-gradient(135deg, #ffe9a8 0%, var(--warm-gold) 100%);
      border-radius: 16px; box-shadow: 0 8px 28px var(--gold-glow);
      transition: transform 0.35s var(--ease-smooth), box-shadow 0.5s var(--ease-smooth);
      animation: yes-soft-glow 3s ease-in-out infinite;
    }
    @keyframes yes-soft-glow {
      0%,100%{box-shadow:0 8px 28px var(--gold-glow)}
      50%{box-shadow:0 8px 36px rgba(246,201,107,.45)}
    }
    #btn-no.strong-glow { animation: yes-strong-glow 1.2s ease-in-out infinite; transform: scale(1.03); }
    @keyframes yes-strong-glow {
      0%,100%{box-shadow:0 0 24px rgba(246,201,107,.55),0 0 48px rgba(247,168,184,.25),0 12px 40px var(--gold-glow)}
      50%{box-shadow:0 0 40px rgba(246,201,107,.85),0 0 70px rgba(247,168,184,.35),0 16px 50px var(--gold-glow)}
    }
    #btn-no:hover { transform: translateY(-3px) scale(1.02); }
    #btn-no:focus-visible { outline: 2px solid var(--soft-cream); outline-offset: 4px; }
    #btn-yes-escape {
      position: fixed; z-index: 120; min-width: 120px;
      padding: 0.9rem 1.35rem; font-size: 1rem; font-weight: 600;
      color: var(--soft-cream); background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.18); border-radius: 14px;
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 6px 24px rgba(0,0,0,.35);
      touch-action: none; user-select: none; will-change: left, top;
    }
    #btn-yes-escape.shake { animation: btn-shake 0.16s ease-in-out; }
    @keyframes btn-shake {
      0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px) rotate(-2deg)} 75%{transform:translateX(4px) rotate(2deg)}
    }
    #btn-yes-escape:focus-visible { outline: 2px solid var(--moonlight-blue); outline-offset: 3px; }
    .float-msg {
      position: fixed; transform: translate(-50%, -100%);
      font-size: 0.82rem; color: rgba(255,243,208,.88);
      background: rgba(16,23,53,.75); border: 1px solid rgba(246,201,107,.25);
      padding: 0.4rem 0.75rem; border-radius: 100px; white-space: nowrap;
      box-shadow: 0 8px 24px rgba(0,0,0,.35);
      animation: msg-float 2.1s var(--ease-smooth) forwards; pointer-events: none; z-index: 125;
    }
    @keyframes msg-float {
      0%{opacity:0;transform:translate(-50%,-80%) scale(.9)}
      12%{opacity:1;transform:translate(-50%,-100%) scale(1)}
      75%{opacity:1;transform:translate(-50%,-130%)}
      100%{opacity:0;transform:translate(-50%,-160%) scale(.95)}
    }
    .playful-hint {
      position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
      font-size: 0.75rem; color: rgba(255,243,208,.35); pointer-events: none;
    }
    .playful-dot {
      position: absolute; bottom: -8px; width: 3px; height: 3px; border-radius: 50%;
      background: var(--warm-gold); opacity: 0.5; animation: dot-rise 9s linear infinite;
    }
    @keyframes dot-rise {
      0%{opacity:0;transform:translateY(0)} 12%{opacity:.65} 100%{opacity:0;transform:translateY(-105vh)}
    }

    /* ===== CINEMATIC INTRO ===== */
    #intro {
      position: fixed; inset: 0; z-index: 100;
      display: flex; align-items: center; justify-content: center;
      background: radial-gradient(ellipse 80% 60% at 50% 30%, var(--royal-violet) 0%, transparent 55%), var(--deep-navy);
      transition: opacity 0.9s var(--ease-smooth), transform 0.9s var(--ease-out-expo);
    }
    #intro.exiting { opacity: 0; transform: scale(1.04); pointer-events: none; }
    .intro-glow {
      position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 45%, var(--moon-glow) 0%, transparent 50%);
      animation: intro-glow 6s ease-in-out infinite;
    }
    @keyframes intro-glow { 0%,100%{opacity:.4} 50%{opacity:.75} }
    .intro-content {
      position: relative; z-index: 2; text-align: center;
      padding: 2rem 1.5rem; max-width: 420px;
      animation: content-in 1.2s var(--ease-out-expo) both;
    }
    .intro-title { font-size: clamp(1.35rem,5vw,1.75rem); font-weight: 600; line-height: 1.55; margin-bottom: 1rem; }
    .intro-sub { font-size: clamp(0.9rem,3.5vw,1rem); line-height: 1.85; color: rgba(255,243,208,.7); margin-bottom: 2rem; }
    #btn-start {
      display: inline-block; min-width: 200px; padding: 1rem 2rem;
      font-size: 1.05rem; font-weight: 600; color: var(--deep-navy);
      background: linear-gradient(135deg, #ffe9a8, var(--warm-gold));
      border-radius: 16px; box-shadow: 0 8px 32px var(--gold-glow);
      transition: transform 0.35s var(--ease-smooth), box-shadow 0.35s;
    }
    #btn-start:hover { transform: translateY(-3px); box-shadow: 0 12px 40px var(--gold-glow); }
    #btn-start:focus-visible { outline: 2px solid var(--soft-cream); outline-offset: 4px; }

    /* ===== SCENE ===== */
    #scene {
      position: fixed; inset: 0; z-index: 0; opacity: 0;
      transition: opacity 1.1s var(--ease-smooth); pointer-events: none;
    }
    #scene.visible { opacity: 1; }
    .scene-gradient {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 130% 90% at 50% -10%, var(--royal-violet) 0%, transparent 55%),
        radial-gradient(ellipse 70% 50% at 85% 85%, rgba(247,168,184,.12) 0%, transparent 50%),
        radial-gradient(ellipse 60% 45% at 8% 75%, var(--moon-glow) 0%, transparent 45%),
        linear-gradient(180deg, var(--deep-navy) 0%, var(--midnight-blue) 48%, var(--deep-navy) 100%);
      transition: background 1.2s var(--ease-smooth);
    }
    #scene.warm .scene-gradient {
      background:
        radial-gradient(ellipse 100% 70% at 50% 15%, rgba(246,201,107,.18) 0%, transparent 55%),
        radial-gradient(ellipse 80% 55% at 50% 100%, rgba(246,201,107,.1) 0%, transparent 50%),
        linear-gradient(180deg, var(--deep-navy) 0%, var(--midnight-blue) 50%, var(--deep-navy) 100%);
    }
    #scene.final .scene-gradient {
      background:
        radial-gradient(ellipse 90% 60% at 50% 40%, rgba(246,201,107,.22) 0%, transparent 60%),
        linear-gradient(180deg, var(--deep-navy) 0%, #1a1428 50%, var(--deep-navy) 100%);
    }
    .scene-nebula {
      position: absolute; inset: 0;
      background: radial-gradient(circle at 30% 40%, rgba(42,30,74,.5) 0%, transparent 45%),
        radial-gradient(circle at 70% 60%, rgba(122,231,199,.06) 0%, transparent 40%);
      animation: nebula-drift 20s ease-in-out infinite alternate;
    }
    @keyframes nebula-drift { from{opacity:.5;transform:scale(1)} to{opacity:.8;transform:scale(1.05) translate(2%,-1%)} }
    .scene-beam {
      position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: min(90vw,500px); height: 55vh;
      background: linear-gradient(180deg, var(--moon-glow) 0%, transparent 85%);
      filter: blur(40px); opacity: 0.5; animation: beam-pulse 6s ease-in-out infinite;
    }
    @keyframes beam-pulse { 0%,100%{opacity:.35} 50%{opacity:.65} }
    .cloud {
      position: absolute; border-radius: 50%;
      background: radial-gradient(ellipse, rgba(255,255,255,.04) 0%, transparent 70%);
      filter: blur(25px);
    }
    .cloud1 { width:280px;height:80px;top:12%;left:-5%;animation:cloud-drift 45s linear infinite; }
    .cloud2 { width:220px;height:70px;top:28%;right:-8%;animation:cloud-drift 55s linear infinite reverse; }
    .cloud3 { width:320px;height:90px;bottom:20%;left:20%;animation:cloud-drift 60s linear infinite; animation-delay:-20s; }
    @keyframes cloud-drift { from{transform:translateX(0)} to{transform:translateX(40px)} }

    /* Stars field */
    #stars-layer, #particles-layer, #petals-layer, #golden-rain, #hearts-layer {
      position: fixed; inset: 0; pointer-events: none; overflow: hidden;
    }
    #stars-layer { z-index: 1; }
    #particles-layer { z-index: 2; }
    #petals-layer { z-index: 3; }
    #hearts-layer { z-index: 3; }
    #golden-rain { z-index: 5; }
    .sky-star {
      position: absolute; border-radius: 50%; background: var(--soft-cream);
      box-shadow: 0 0 6px var(--moonlight-blue);
      animation: twinkle ease-in-out infinite;
    }
    @keyframes twinkle { 0%,100%{opacity:.3;transform:scale(1)} 50%{opacity:1;transform:scale(1.4)} }
    .particle {
      position: absolute; bottom: -10px; border-radius: 50%;
      background: var(--warm-gold); box-shadow: 0 0 8px var(--gold-glow);
      animation: float-up linear infinite; opacity: 0;
    }
    @keyframes float-up {
      0%{opacity:0;transform:translateY(0) scale(.4)}
      12%{opacity:.75} 88%{opacity:.35}
      100%{opacity:0;transform:translateY(-105vh) translateX(var(--drift)) scale(1)}
    }
    .petal {
      position: absolute; top: -20px; width: 11px; height: 15px;
      background: linear-gradient(135deg, var(--rose-glow), rgba(200,130,150,.5));
      border-radius: 50% 50% 50% 0; opacity: 0.45;
      animation: petal-fall linear infinite;
    }
    @keyframes petal-fall {
      0%{opacity:0;transform:translateY(-5vh) rotate(var(--rot))}
      8%{opacity:.55} 100%{opacity:.15;transform:translateY(108vh) rotate(calc(var(--rot) + 400deg))}
    }
    .golden-flake {
      position: absolute; top: -10px; border-radius: 50%;
      background: linear-gradient(135deg, var(--warm-gold), var(--soft-cream));
      box-shadow: 0 0 8px var(--gold-glow);
      animation: golden-fall linear infinite; opacity: 0;
    }
    @keyframes golden-fall {
      0%{opacity:0;transform:translateY(0)} 8%{opacity:.85} 100%{opacity:.2;transform:translateY(105vh) rotate(180deg)}
    }
    .subtle-heart {
      position: absolute; width: 6px; height: 6px; background: var(--rose-glow);
      opacity: 0.15; transform: rotate(45deg);
      animation: heart-drift 8s ease-in-out infinite;
      box-shadow: 0 0 12px rgba(247,168,184,.25);
    }
    .subtle-heart::before, .subtle-heart::after {
      content: ""; position: absolute; width: 6px; height: 6px;
      background: inherit; border-radius: 50%;
    }
    .subtle-heart::before { top: -3px; left: 0; }
    .subtle-heart::after { left: -3px; top: 0; }
    @keyframes heart-drift {
      0%,100%{opacity:.08;transform:rotate(45deg) translateY(0)}
      50%{opacity:.22;transform:rotate(45deg) translateY(-12px)}
    }

    /* Lanterns */
  #lanterns { position: fixed; inset: 0; z-index: 4; pointer-events: none; }
    .lantern { position: absolute; animation: sway 5.5s ease-in-out infinite; }
    .lantern-left { left: clamp(4%,6vw,8%); top: 22%; }
    .lantern-right { right: clamp(4%,6vw,8%); top: 26%; animation-delay: 1.2s; }
    @media (max-width:500px) {
      .lantern-left,.lantern-right { transform: scale(.78); }
      .lantern-left { top: 16%; } .lantern-right { top: 20%; }
    }
    .l-hook { width:2px;height:10px;background:var(--warm-gold);margin:0 auto;border-radius:1px; }
    .l-cap { width:8px;height:10px;margin:0 auto;background:linear-gradient(180deg,var(--warm-gold),#9a7a3a);border-radius:2px 2px 0 0; }
    .l-body {
      width: clamp(26px,7vw,38px); height: clamp(34px,9vw,50px); margin: 0 auto;
      border-radius: 8px 8px 12px 12px;
      background: linear-gradient(180deg, rgba(255,210,120,.95), rgba(255,160,70,.9), rgba(190,100,45,.95));
      box-shadow: 0 0 18px rgba(255,170,70,.45);
      transition: box-shadow 0.8s var(--ease-smooth); position: relative;
    }
    .l-body::after { content:""; position:absolute; inset:5px; border:1px solid rgba(255,230,170,.35); border-radius:5px; }
    .lantern.glow .l-body { box-shadow: 0 0 28px rgba(255,190,90,.75), 0 0 50px rgba(246,201,107,.35); }
    .l-light {
      position: absolute; bottom: -28px; left: 50%; transform: translateX(-50%);
      width: 55px; height: 35px;
      background: radial-gradient(ellipse, rgba(255,175,80,.45) 0%, transparent 70%);
      animation: flicker 2.2s ease-in-out infinite;
    }
    .lantern.glow .l-light { background: radial-gradient(ellipse, rgba(255,200,100,.65) 0%, transparent 70%); }
    @keyframes sway { 0%,100%{transform:rotate(-2.5deg)} 50%{transform:rotate(2.5deg)} }
    @keyframes flicker { 0%,100%{opacity:.65} 50%{opacity:1} }

    /* Moon */
    #moon-btn {
      position: fixed; top: clamp(1.5rem,6vh,3rem); left: 50%;
      transform: translateX(-50%); z-index: 20;
      padding: 12px; background: none; border: none; cursor: pointer;
      opacity: 0; transition: opacity 1s var(--ease-smooth), transform 1s var(--ease-out-expo);
    }
    #moon-btn.visible { opacity: 1; }
    #moon-btn:focus-visible { outline: 2px solid var(--warm-gold); outline-offset: 6px; border-radius: 50%; }
    .moon-wrap {
      position: relative; width: clamp(64px,16vw,100px); height: clamp(64px,16vw,100px);
      filter: drop-shadow(0 0 24px rgba(255,243,208,.45));
      transition: filter 0.8s var(--ease-smooth);
    }
    #moon-btn.celebration .moon-wrap { filter: drop-shadow(0 0 40px rgba(246,201,107,.75)); }
    .moon-halo {
      position: absolute; inset: -50%; border-radius: 50%;
      background: radial-gradient(circle, var(--moon-glow) 0%, transparent 68%);
      animation: halo 4.5s ease-in-out infinite; pointer-events: none;
    }
    @keyframes halo { 0%,100%{opacity:.5;transform:scale(1)} 50%{opacity:.9;transform:scale(1.08)} }
    .moon-disc {
      position: absolute; inset: 0; border-radius: 50%;
      background: linear-gradient(145deg, #fff9e8, #f0e4c8 45%, #e2d4b0);
      box-shadow: inset -6px -6px 18px rgba(255,255,255,.35);
    }
    .moon-shadow {
      position: absolute; top: -4%; right: -14%; width: 86%; height: 96%;
      border-radius: 50%; background: var(--midnight-blue);
      transition: background 1s var(--ease-smooth);
    }
    .moon-hint {
      position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%);
      width: 4px; height: 4px; border-radius: 50%; background: var(--warm-gold);
      opacity: 0.35; animation: hint-pulse 3s ease-in-out infinite;
    }
    @keyframes hint-pulse { 0%,100%{opacity:.2} 50%{opacity:.55} }

    /* Collectible stars */
    #collect-stars { position: fixed; inset: 0; z-index: 25; pointer-events: none; }
    .star-hint {
      position: fixed; top: clamp(5.5rem,14vh,7rem); left: 50%; transform: translateX(-50%);
      font-size: 0.8rem; color: rgba(255,243,208,.55); white-space: nowrap; pointer-events: none;
    }
    .collect-star {
      position: absolute; width: 44px; height: 44px; margin: -22px 0 0 -22px;
      pointer-events: auto; animation: star-float 3s ease-in-out infinite;
    }
    .collect-star:focus-visible { outline: 2px solid var(--warm-gold); outline-offset: 4px; border-radius: 50%; }
    .star-shape {
      display: block; width: 28px; height: 28px; margin: 8px auto;
      background: var(--warm-gold);
      clip-path: polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);
      filter: drop-shadow(0 0 10px var(--warm-gold));
      transition: transform 0.3s var(--ease-smooth);
    }
    .collect-star:hover .star-shape { transform: scale(1.15); }
    @keyframes star-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }

    /* Main card */
    #main-wrap {
      position: relative; z-index: 15; min-height: 100vh; min-height: 100dvh;
      display: flex; align-items: center; justify-content: center;
      padding: clamp(7rem,20vh,9rem) 1.25rem 4rem;
      opacity: 0; transform: translateY(24px);
      transition: opacity 1s var(--ease-smooth) 0.2s, transform 1s var(--ease-out-expo) 0.2s;
      pointer-events: none;
    }
    #main-wrap.visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
    #main-card {
      position: relative; width: min(100%, 440px);
      padding: clamp(1.75rem,5vw,2.5rem);
      background: var(--glass); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
      border: 1px solid var(--glass-border); border-radius: var(--card-radius);
      box-shadow: 0 28px 90px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.06) inset, 0 0 60px var(--gold-glow);
      transition: box-shadow 0.8s var(--ease-smooth), border-color 0.8s;
      animation: card-float 5s ease-in-out infinite;
      transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
      will-change: transform;
    }
    #main-wrap.visible #main-card {
      animation: card-enter 1s var(--ease-out-expo) 0.4s both, card-float 5s ease-in-out 1.5s infinite;
    }
    #main-card.expanded {
      border-color: rgba(246,201,107,.35);
      box-shadow: 0 32px 100px rgba(0,0,0,.5), 0 0 80px var(--gold-glow);
    }
    #main-card.celebration {
      box-shadow: 0 32px 100px rgba(0,0,0,.5), 0 0 100px rgba(246,201,107,.4);
    }
    @keyframes card-enter {
      from { opacity:0; transform: perspective(900px) translateY(36px) scale(.94); }
      to { opacity:1; transform: perspective(900px) translateY(0) scale(1); }
    }
    @keyframes card-float {
      0%,100%{transform:perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(0)}
      50%{transform:perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(-6px)}
    }
    .ornament { position: absolute; width: 36px; height: 36px; border: 1px solid rgba(246,201,107,.35); opacity: 0.55; }
    .orn-tl { top:14px; right:14px; border-left:none; border-bottom:none; border-radius:0 10px 0 0; }
